# Frontend environment variables
# Copy to .env and set values for your deployment.

# API base URL — set to your deployed backend URL for production.
# Leave empty or omit for local development (Vite proxy handles /api → localhost:8000).
# Example: VITE_API_BASE_URL=https://upi-safeguard-api.onrender.com/api/v1
VITE_API_BASE_URL=
