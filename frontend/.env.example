# Frontend environment variables
# Copy to .env and set values for your deployment.

# API base URL — set to your deployed backend URL for production.
# Leave empty or omit for local development (Vite proxy handles /api → localhost:8000).
# Example: VITE_API_BASE_URL=https://upi-safeguard-api.onrender.com/api/v1
VITE_API_BASE_URL=

# Firebase Public Configuration (Optional - for Phone Auth OTP SMS verification)
# Get these from Firebase Console > Project Settings
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
