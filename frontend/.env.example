# ============================================================
# UPI SafeGuard — Frontend Environment Variables Template
# ============================================================
# Copy this file to .env.local (or .env) and set your values.
# NEVER commit the actual .env / .env.local file.

# Development (Vite proxy handles /api → localhost:8000)
# Leave empty to use the Vite dev-server proxy (default)
VITE_API_BASE_URL=

# Production / Render deployment
# Set to your deployed backend URL, e.g.:
# VITE_API_BASE_URL=https://upi-safeguard-backend.onrender.com/api/v1

# Firebase (optional — for phone OTP auth)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
