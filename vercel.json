{
    "buildCommand": "cd frontend && npm install --no-audit --no-fund && npm run build",
    "outputDirectory": "frontend/dist",
    "rewrites": [
        {
            "source": "/api/v1/:path*",
            "destination": "https://upi-safeguard-backend.onrender.com/api/v1/:path*"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
