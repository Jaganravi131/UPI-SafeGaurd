# ===================================================
# UPI SafeGuard — Backend Environment Configuration
# ===================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── REQUIRED ────────────────────────────────────────
# These must be set for the app to function.

# JWT Authentication
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=<your-strong-random-secret>
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# Admin Login
ADMIN_DEFAULT_PASSWORD=<your-admin-password>

# ── OPTIONAL — Database ─────────────────────────────
# Without these, the app falls back to SQLite (fine for demos).
# POSTGRES_URL=postgresql+asyncpg://user:password@host:5432/dbname
# MONGODB_URL=mongodb://localhost:27017
# REDIS_URL=redis://localhost:6379

# ── OPTIONAL — OTP Delivery ─────────────────────────
# Without SMTP/Twilio, OTP uses a dev-fallback that logs the code
# server-side only. Registration still works — check backend logs
# for the OTP value.
# For local demos only, set EXPOSE_DEMO_OTP=true to show the generated code in
# the UI. Never enable this in production.
#
# Twilio SMS:
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ── OPTIONAL — AI Features (Groq LLM) ──────────────
# Without this key, AI chat uses deterministic demo guidance when
# DEMO_AI_FALLBACK=true; set it to false for strict production behavior.
# GROQ_API_KEY=<your-groq-api-key>
# GROQ_MODEL=llama-3.3-70b-versatile
# DEMO_AI_FALLBACK=false

# ── OPTIONAL — Firebase Auth ────────────────────────
# FIREBASE_PROJECT_ID=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_CLIENT_EMAIL=

# ── CORS ────────────────────────────────────────────
# Add your deployed frontend URL here for production.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── Rate Limiting ───────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
