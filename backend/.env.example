# ===================================================
# UPI SafeGuard — Environment Configuration Template
# ===================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Application ──────────────────────────────────────
DEBUG=true
ENVIRONMENT=development

# ── JWT Authentication (REQUIRED) ────────────────────
# Generate a strong random key: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=<your-strong-random-secret>
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ── Admin (REQUIRED) ────────────────────────────────
ADMIN_DEFAULT_PASSWORD=<your-admin-password>

# ── Database — PostgreSQL (REQUIRED for production) ──
POSTGRES_URL=postgresql+asyncpg://user:password@host:5432/dbname

# ── Database — MongoDB (optional) ───────────────────
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=upi_safeguard

# ── Database — Redis (optional) ─────────────────────
REDIS_URL=redis://localhost:6379

# ── Groq LLM — AI features (REQUIRED) ──────────────
GROQ_API_KEY=<your-groq-api-key>
GROQ_MODEL=llama-3.3-70b-versatile

# ── Risk Thresholds ─────────────────────────────────
RISK_THRESHOLD_LOW=0.3
RISK_THRESHOLD_MEDIUM=0.6
RISK_THRESHOLD_HIGH=0.85

# ── Firebase (optional) ─────────────────────────────
# FIREBASE_PROJECT_ID=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_CLIENT_EMAIL=

# ── Twilio SMS (optional) ───────────────────────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ── AWS S3 (optional) ──────────────────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=ap-south-1

# ── CORS ────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── Rate Limiting ───────────────────────────────────
RATE_LIMIT_PER_MINUTE=60