# ===================================================
# UPI SafeGuard — docker-compose Environment Template
# ===================================================
# Copy this file to .env and fill in your values.
# This file is used by docker-compose.yml.
# NEVER commit .env to version control.

# ── PostgreSQL ────────────────────────────────────
POSTGRES_USER=upi_user
POSTGRES_PASSWORD=<strong-db-password>
POSTGRES_DB=upi_safeguard

# ── JWT Authentication (REQUIRED) ────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=<your-strong-random-secret>
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ── Admin (REQUIRED) ─────────────────────────────
ADMIN_DEFAULT_PASSWORD=<your-admin-password>

# ── Groq LLM (REQUIRED for AI features) ──────────
GROQ_API_KEY=<your-groq-api-key>
GROQ_MODEL=llama-3.3-70b-versatile

# ── Application ───────────────────────────────────
DEBUG=false
ENVIRONMENT=production

# ── Risk Thresholds ───────────────────────────────
RISK_THRESHOLD_LOW=0.3
RISK_THRESHOLD_MEDIUM=0.6
RISK_THRESHOLD_HIGH=0.85

# ── CORS ──────────────────────────────────────────
# Set to your frontend domain in production
CORS_ORIGINS=["http://localhost"]

# ── Firebase (optional) ───────────────────────────
# FIREBASE_PROJECT_ID=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_CLIENT_EMAIL=

# ── Twilio SMS (optional) ─────────────────────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ── Rate Limiting ─────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
